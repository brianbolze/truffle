# Truffle — API keys. Copy this file to `.env` (gitignored) and fill in the values:
#   cp .env.example .env
#
# Where the code looks for each key:
#   - All keys: the process environment, falling back to a `.env` at the repo root.
#   - FIRECRAWL_API_KEY also resolves from ~/.claude/settings.json (the "env" block) so the
#     global /research-company skill can find it.
#
# If this tool is primarily being run by Claude Code, you can also just put these environment
# variables in your ~/.claude/settings.json file - in the "env" block.
#

# --- Required: core company capture (/research-company, fc.py) ---
FIRECRAWL_API_KEY=

# --- Optional: external signal tools (tools/) — only needed if you run these ---
SERP_API_KEY=     # SerpApi — SERP visibility (tools/serpapi.py, tools/serp_intent_panel.py)
EXA_API_KEY=      # Exa — neighbor / similar-site discovery (tools/exa_similar.py)
