# Secrets
.env
.env.*
# ...but DO track the template
!.env.example

# Payload sidecars — raw Firecrawl JSON + screenshots. Large, regenerable, iCloud-synced.
**/.payloads/
**/*.payloads/

# Derived screenshot tiles — sliced from .payloads (tile.py) or browser-rendered (shoot.py) for the
# visual-evidence module. Large, regenerable; visual.md (committed) is the durable artifact. (Whether to
# promote the cited tiles to a committed path for clone-durable falsifiability is an open call — see VISUAL.md.)
**/captures/*/tiles/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ruff_cache
.pytest_cache/

# OS / iCloud
.DS_Store
*.icloud

# Experiment scratch output (keep READMEs + scripts + FINDINGS, ignore bulk dumps)
experiments/**/_out/
# Derived artifacts root — briefs/sheets/index (scripts/present/) + store.db (scripts/build_db.py).
# Regenerable lenses, never source of truth — and never inside store/ (the agent surface).
_out/
scripts/_out/  # legacy path — delete the dir after the 2026-06-12 demo
# self-contained embedded-image sheets — bulk, regenerable from _out/
experiments/**/contact-sheet.html

# Temporary files
_temp/